rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && profile().role == "admin"; }
    function ownRoll(roll) { return signedIn() && profile().role == "student" && profile().roll == roll; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false; // created only by the trusted setup script
    }

    match /attendance/{roll}/records/{recordId} {
      allow read, create, update: if isAdmin() || ownRoll(roll);
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}